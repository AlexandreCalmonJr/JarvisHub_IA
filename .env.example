# Configuração do JARVIS AI HUB (Ambiente Local)
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Runtime Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MASTER_MODEL=llama3.2:3b
DEFAULT_CODER_MODEL=qwen2.5-coder:7b
DEFAULT_REASONING_MODEL=qwen2.5:7b

# Segurança e Restrições
ALLOWLIST_WORKSPACE_ROOT=./workspace
STRICT_PERMISSION_CHECK=true
MAX_CONCURRENT_INFERENCES=1
ENABLE_KILL_SWITCH=true
SESSION_EXPIRY_HOURS=24

# Chaves externas (OPCIONAIS e desativadas por padrão)
ONLINE_GATEWAY_ENABLED=false
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Hostnames autorizados para leitura de p�ginas web (separados por v�rgula); vazio desativa a leitura.
JARVIS_WEB_READ_ALLOWED_HOSTS=
