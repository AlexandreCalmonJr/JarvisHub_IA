# =====================================================================
# JARVIS AI HUB 3.0.1 — variáveis de ambiente reconhecidas pelo código
# =====================================================================
# Copie para `.env` (ignorado pelo Git) apenas o que precisar alterar.
# Nenhuma senha ou chave deve ser versionada. Este arquivo lista somente
# variáveis que o código realmente lê; valores vazios = comportamento padrão.

# --- Núcleo de execução ---------------------------------------------------
# `development`|`dev`|`local` habilitam a senha de homologação (admin/jarvishub).
# `production`|`prod` exigem JARVIS_BOOTSTRAP_ADMIN_PASSWORD na primeira execução.
# Ausente: o admin inicial recebe uma senha aleatória em data/auth/.initial-admin-password.
JARVIS_ENVIRONMENT=
JARVIS_DATA_DIR=
JARVIS_WORKSPACE_DIR=
JARVIS_DATABASE_PATH=
JARVIS_DATABASE_URL=
JARVIS_MODEL_DIR=
JARVIS_API_URL=
JARVIS_ENABLE_API_DOCS=

# --- Autenticação e credenciais ------------------------------------------
JARVIS_ADMIN_TOKEN=
JARVIS_BOOTSTRAP_ADMIN_PASSWORD=
JARVIS_BOOTSTRAP_TTL=
JARVIS_ISSUE_BOOTSTRAP=

# --- Rede, CORS e exposição ----------------------------------------------
# Origens separadas por vírgula. Loopback já é permitido por padrão.
# Para expor o dashboard servido por outro host, liste aqui a origem exata.
JARVIS_ALLOWED_ORIGINS=

# --- Inferência local (Ollama) -------------------------------------------
JARVIS_OLLAMA_BASE_URL=
# Alias legado reconhecido:
OLLAMA_BASE_URL=
JARVIS_OLLAMA_KEEP_ALIVE=
JARVIS_OLLAMA_NUM_CTX=
JARVIS_OLLAMA_WARMUP=
JARVIS_OLLAMA_WARMUP_MODELS=
JARVIS_MODEL_AFFINITY_SECONDS=
OLLAMA_NUM_PARALLEL=

# --- Embeddings e conhecimento -------------------------------------------
JARVIS_EMBEDDING_MODEL=

# --- Sandbox e leitura web -----------------------------------------------
# `subprocess` (padrão) ou `container` (Docker/Podman com fallback).
JARVIS_SANDBOX_DRIVER=
JARVIS_WEB_READ_ALLOWED_HOSTS=
# Raízes autorizadas para importar projetos externos (separadas por `;` no
# Windows e `,` nos demais). Vazio: apenas o workspace interno.
# Suporta também o alias ALLOWLIST_WORKSPACE_ROOT.
JARVIS_WORKSPACE_IMPORT_ROOTS=
ALLOWLIST_WORKSPACE_ROOT=

# --- Integrações omnicanal (webhooks assinados) --------------------------
# Telegram: valor do `secret_token` enviado no cabeçalho
# X-Telegram-Bot-Api-Secret-Token. Sem valor, o endpoint responde 503.
JARVIS_TELEGRAM_WEBHOOK_SECRET=
# Discord: chave pública Ed25519 (hex) da aplicação. Sem valor, responde 503.
JARVIS_DISCORD_PUBLIC_KEY=

# --- Voz (opcional) -------------------------------------------------------
JARVIS_VOICE_API=
JARVIS_VOICE_TOKEN=
JARVIS_TOKEN=
JARVIS_STT_MODEL=
JARVIS_STT_DEVICE=
JARVIS_STT_COMPUTE_TYPE=
JARVIS_PIPER_EXECUTABLE=
JARVIS_PIPER_MODEL=
JARVIS_WAKEWORD_MODEL=
JARVIS_WAKEWORD_THRESHOLD=
JARVIS_VAD_RMS=
