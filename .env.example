# =====================================================================
# JARVIS AI HUB 3.0.1 — Variáveis de Ambiente Harmonizadas
# =====================================================================
# Copie para `.env` (ignorado pelo Git) apenas o que precisar alterar.
# Nenhuma senha ou chave deve ser versionada. Este arquivo lista as
# configurações do ecossistema unificado: FastAPI Core, Brain Server,
# Vite Frontend, Go Gateway e Inferência Local.

# =====================================================================
# 1. NÚCLEO E ARMAZENAMENTO (CORE & STORAGE)
# =====================================================================
# `development`|`dev`|`local` habilitam a senha de homologação (admin/jarvishub).
# `production`|`prod` exigem JARVIS_BOOTSTRAP_ADMIN_PASSWORD na primeira execução.
# Ausente: o admin inicial recebe uma senha aleatória em data/auth/.initial-admin-password.
JARVIS_ENVIRONMENT=development
JARVIS_DATA_DIR=data
JARVIS_WORKSPACE_DIR=workspace
JARVIS_MODEL_DIR=
JARVIS_API_URL=http://127.0.0.1:8000
JARVIS_ENABLE_API_DOCS=true

# =====================================================================
# 2. FASTAPI CORE (PYTHON BACKEND — PORTA 8000)
# =====================================================================
PORT=8000
JARVIS_PORT=8000

# `sqlite` é o padrão local. `postgresql` ativa o runtime SQLAlchemy + psycopg.
# Exemplo: postgresql+psycopg://jarvis_app:senha@127.0.0.1:5432/jarvis_hub
JARVIS_DATABASE_BACKEND=sqlite
JARVIS_DATABASE_PATH=data/jarvis.db
JARVIS_DATABASE_URL=
JARVIS_DATABASE_POOL_SIZE=
JARVIS_DATABASE_MAX_OVERFLOW=
JARVIS_DATABASE_POOL_TIMEOUT=
JARVIS_DATABASE_POOL_RECYCLE=
JARVIS_DATABASE_ECHO=

# Origens permitidas para CORS (separadas por vírgula). Loopback já é permitido por padrão.
JARVIS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =====================================================================
# 3. SECOND BRAIN SERVER (NODE.JS / TYPESCRIPT — PORTA 3001)
# =====================================================================
BRAIN_PORT=3001
BRAIN_MODE=local_sqlite
SQLITE_DATA_DIR=.jarvis-brain
JWT_SECRET=
GEMINI_API_KEY=
PYTHON_BIN=.venv\Scripts\python.exe
BRAIN_NAME=Esta Máquina · Local (Sem Docker)
ASSISTANT_NAME=JARVIS
GITHUB_TOKEN=

# =====================================================================
# 4. VITE DEV SERVER & PROXY TARGETS (PORTA 3000)
# =====================================================================
# O Vite dev server escuta na porta 3000 e despacha requisições para os backends:
# - Rotas /api/v1/brain, /api/v1/spreadsheets, /api/v1/media, etc. -> BRAIN_PROXY_TARGET (:3001)
# - Rota de WebSocket /ws -> BRAIN_WS_TARGET (:3001)
# - Demais rotas /api -> API_PROXY_TARGET (:8000)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_BRAIN_PROXY_TARGET=http://127.0.0.1:3001
VITE_BRAIN_WS_TARGET=ws://127.0.0.1:3001

# =====================================================================
# 5. INFERÊNCIA LOCAL (OLLAMA) E EMBEDDINGS
# =====================================================================
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_KEEP_ALIVE=
JARVIS_OLLAMA_NUM_CTX=
JARVIS_OLLAMA_WARMUP=
JARVIS_OLLAMA_WARMUP_MODELS=
JARVIS_MODEL_AFFINITY_SECONDS=
OLLAMA_NUM_PARALLEL=
JARVIS_EMBEDDING_MODEL=

# =====================================================================
# 6. GO GATEWAY (EDGE PROXY & CRAWLER — PORTA 8080)
# =====================================================================
GATEWAY_PORT=8080
INTERNAL_GATEWAY_TOKEN=
UPSTREAM_BRAIN_URL=http://127.0.0.1:3001
RATE_LIMIT_RPS=

# =====================================================================
# 7. AUTENTICAÇÃO E CREDENCIAIS
# =====================================================================
JARVIS_ADMIN_TOKEN=
JARVIS_BOOTSTRAP_ADMIN_PASSWORD=
JARVIS_BOOTSTRAP_TTL=
JARVIS_ISSUE_BOOTSTRAP=
JARVIS_BOOTSTRAP_TOKEN=

# =====================================================================
# 8. SANDBOX E LEITURA WEB
# =====================================================================
# `subprocess` (padrão) ou `container` (Docker/Podman com fallback).
JARVIS_SANDBOX_DRIVER=subprocess
JARVIS_WEB_READ_ALLOWED_HOSTS=
# Raízes autorizadas para importar projetos externos (separadas por `;` no
# Windows e `,` nos demais). Vazio: apenas o workspace interno.
JARVIS_WORKSPACE_IMPORT_ROOTS=
ALLOWLIST_WORKSPACE_ROOT=

# =====================================================================
# 9. INTEGRAÇÕES OMNICANAL (WEBHOOKS ASSINADOS)
# =====================================================================
# Telegram: valor do `secret_token` enviado no cabeçalho X-Telegram-Bot-Api-Secret-Token.
JARVIS_TELEGRAM_WEBHOOK_SECRET=
# Discord: chave pública Ed25519 (hex) da aplicação.
JARVIS_DISCORD_PUBLIC_KEY=

# =====================================================================
# 10. VOZ & COMPANION (OPCIONAL)
# =====================================================================
JARVIS_VOICE_API=
JARVIS_VOICE_TOKEN=
JARVIS_TOKEN=
JARVIS_STT_MODEL=
JARVIS_STT_DEVICE=
JARVIS_STT_COMPUTE_TYPE=
JARVIS_PIPER_EXECUTABLE=
JARVIS_PIPER_MODEL=
JARVIS_WAKEWORD_MODEL=
JARVIS_WAKEWORD_THRESHOLD=
JARVIS_VAD_RMS=
