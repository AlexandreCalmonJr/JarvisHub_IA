{
  "name": "jarvis-ai-hub",
  "private": true,
  "version": "3.0.1",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/dashboard"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/dashboard",
    "dev:brain": "npm run dev:brain --workspace apps/dashboard",
    "dev:api": ".venv\\Scripts\\python.exe -m uvicorn apps.api.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "npm run build --workspace apps/dashboard",
    "preview": "npm run preview --workspace apps/dashboard",
    "test": "npm run test --workspace apps/dashboard",
    "test:dashboard": "npm run test:dashboard --workspace apps/dashboard",
    "test:backend": ".venv\\Scripts\\pytest.exe tests/unit -q",
    "test:all": "npm run test:backend && npm run test",
    "verify": ".venv\\Scripts\\python.exe scripts/verify_monorepo.py",
    "test:verify": ".venv\\Scripts\\python.exe scripts/verify_monorepo.py",
    "test:e2e": "npm run test:e2e --workspace apps/dashboard",
    "test:e2e:headed": "npm run test:e2e:headed --workspace apps/dashboard",
    "test:e2e:report": "npm run test:e2e:report --workspace apps/dashboard",
    "typecheck": "npm run typecheck --workspace apps/dashboard"
  }
}
