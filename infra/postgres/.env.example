# Copie para infra/postgres/.env e defina uma senha forte e exclusiva.
POSTGRES_DB=jarvis_hub
POSTGRES_USER=jarvis_app
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_E_UNICA
POSTGRES_PORT=5432

# Usada pelo backend e pelo Alembic. O driver síncrono psycopg é o suportado
# pela camada atual (SQLAlchemy síncrono). Não faça commit deste arquivo.
DATABASE_URL=postgresql+psycopg://jarvis_app:SUBSTITUA_POR_UMA_SENHA_FORTE_E_UNICA@127.0.0.1:5432/jarvis_hub
