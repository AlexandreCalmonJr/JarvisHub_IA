# Copie para infra/postgres/.env e defina uma senha forte e exclusiva.
POSTGRES_DB=jarvis_hub
POSTGRES_USER=jarvis_app
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_E_UNICA
POSTGRES_PORT=5432

# Será usada pelo backend após a implementação do adaptador SQLAlchemy.
# Não publique credenciais reais nem faça commit do arquivo .env.
DATABASE_URL=postgresql+asyncpg://jarvis_app:SUBSTITUA_POR_UMA_SENHA_FORTE_E_UNICA@127.0.0.1:5432/jarvis_hub
